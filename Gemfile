source "https://rubygems.org"

# ponytail: github-pages gem은 Ruby 4 미지원이라 같은 Jekyll 3.10 계열만 직접 지정.
# GitHub Pages 쪽 버전이 바뀌면 https://pages.github.com/versions/ 보고 맞추기.
gem "jekyll", "~> 3.10"
gem "kramdown-parser-gfm"

# Ruby 3.4+에서 기본 포함이 빠진 gem들 (Jekyll 3.x가 필요로 함)
gem "csv"
gem "base64"
gem "bigdecimal"
gem "logger"
gem "webrick"
